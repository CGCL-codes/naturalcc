# ============================================================
# NaturalCC Code Agent 配置模板
#
# 用法：
#   cp .env.example .env
#   # 填好下面的值，然后在启动前加载：
#   set -a; source .env; set +a
#   ./start.sh
#
# 注意：程序本身不会自动读取 .env 文件，所有配置都通过
#       环境变量生效，所以必须先 source 再启动。
#       .env 已被 .gitignore 忽略，不要提交真实密钥。
# ============================================================


# ------------------------------------------------------------
# 1. 模型 API 凭据（可选）
#    Web UI 推荐在页面 Settings 中输入 API Key。
#    CLI、脚本和后端环境变量兜底路径可在启动前设置下面变量。
# ------------------------------------------------------------

# DeepSeek 官方 API（Agent 默认网关优先读取）
DEEPSEEK_API_KEY=

# OpenAI 或任意 OpenAI 兼容服务
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter（走 aider 编辑路径时可用）
OPENROUTER_API_KEY=


# ------------------------------------------------------------
# 2. Agent 运行时：模型与接入点
# ------------------------------------------------------------

# 对话模型名
CODE_AGENT_MODEL=deepseek-chat

# 模型 API base url
CODE_AGENT_API_BASE=https://api.deepseek.com/v1

# 事件库 / 记忆库的 SQLite 文件位置
# 默认：<code_agent>/outputs/agent_runtime.db
# CODE_AGENT_DB=/absolute/path/to/agent_runtime.db

# DeepSeek V3 分词器目录（用于精确 token 计数）
# 默认：<code_agent>/resources/deepseek_v3_tokenizer
# 首次使用请先执行：uv run python scripts/install_deepseek_tokenizer.py
# CODE_AGENT_TOKENIZER_DIR=/absolute/path/to/resources/deepseek_v3_tokenizer


# ------------------------------------------------------------
# 3. 上下文窗口与压缩策略
#    这些值决定「什么时候把历史对话压缩成 checkpoint」
# ------------------------------------------------------------

# 模型上下文窗口总大小
CODE_AGENT_CONTEXT_WINDOW_TOKENS=65536

# 给模型输出预留的 token
CODE_AGENT_OUTPUT_RESERVE_TOKENS=4096

# 安全余量，防止计数误差撑爆窗口
CODE_AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=512

# 厂商侧协议开销的估算值
CODE_AGENT_PROVIDER_FRAMING_TOKENS=256

# 占用率达到该比例时触发压缩（0.72 × 65536 ≈ 47k tokens）
CODE_AGENT_COMPACTION_TRIGGER_RATIO=0.72

# 压缩后希望回落到的比例（0.50 × 65536 ≈ 32k tokens）
CODE_AGENT_COMPACTION_TARGET_RATIO=0.50

# 压缩流程中 analyzer / summarizer 两阶段的输出上限
CODE_AGENT_ANALYZER_OUTPUT_TOKENS=4096
CODE_AGENT_SUMMARIZER_OUTPUT_TOKENS=2048


# ------------------------------------------------------------
# 4. CodeGraph 知识图谱
#    需要额外安装 codegraph 可执行文件：
#    macOS / Linux / WSL:
#      curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | sh
#    Windows PowerShell:
#      irm https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.ps1 | iex
#    或：npm i -g @colbymchenry/codegraph
#    安装后重新打开终端并执行：codegraph --version
# ------------------------------------------------------------

# codegraph 可执行文件路径或命令名
CODE_AGENT_CODEGRAPH_BIN=codegraph

# 单次调用超时秒数（上限 600）
CODE_AGENT_CODEGRAPH_TIMEOUT=60

# 禁止 codegraph 自行下载依赖 / 禁止常驻守护进程
CODE_AGENT_CODEGRAPH_NO_DOWNLOAD=true
CODE_AGENT_CODEGRAPH_NO_DAEMON=true


# ------------------------------------------------------------
# 5. 测试脚本用（可选）
# ------------------------------------------------------------

# smoke_test.py / test_deepseek*.py 请求的服务地址
# CODE_AGENT_BASE_URL=http://127.0.0.1:7860


# ------------------------------------------------------------
# 6. Neo4j 导入脚本用（可选，仅 rag/c/json2neo4j.py 需要）
# ------------------------------------------------------------

# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# CGRAPH_JSON=/absolute/path/to/symbol_graph.json


# ------------------------------------------------------------
# 7. 离线评测用（可选，仅 rag/ 下的 vLLM 脚本需要）
# ------------------------------------------------------------

# CUDA_VISIBLE_DEVICES=0
# TIKTOKEN_CACHE_DIR=
# HF_ALLOW_CODE_EVAL=1
# TOKENIZERS_PARALLELISM=false
